# Database. SQLite for development; for production use Postgres and change the provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Public site URL (used for sitemap, canonical URLs, Open Graph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: contact address shown on /contact (grown-ups only).
NEXT_PUBLIC_CONTACT_EMAIL=""

# Optional: adult donation link, shown ONLY inside the signed-in parent dashboard. Leave blank to hide.
DONATION_URL=""

# Seed script (npm run db:seed): creates an admin account if both are set.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Seed script: local demo parent account for testing (test value only, never a real password).
DEMO_PARENT_EMAIL="parent@kqa.test"
DEMO_PARENT_PASSWORD="kingdom-quest-demo-2026"

# Narration recording (npm run record:narration -- --yes). Spends ElevenLabs credits.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
